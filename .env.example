# =============================================================================
# Domisafe — plantilla de variables de entorno
#
# Copia este fichero a .env EN EL SERVIDOR (nunca en git):
#   cp .env.example .env && chmod 600 .env && chown domisafe:domisafe .env
# =============================================================================

# --- Núcleo -------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://domisafe.org

# --- Cloudflare Turnstile (CAPTCHA del formulario público) --------------------
# Obligatorio en producción: sin esto la API de escaneo devuelve 503.
# https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Base de datos / caché ----------------------------------------------------
# Fase 1 usa caché en memoria. Fase 2 activa SQLite (ruta fuera del repo).
DATABASE_URL=file:/home/domisafe/data/domisafe.sqlite

# --- Rate limiting ------------------------------------------------------------
# Escaneos por IP y ventana. Conservador: el servidor es doméstico.
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_SCANS=10
# TTL de la caché de informes (segundos). Evita repetir llamadas de pago.
SCAN_CACHE_TTL_SECONDS=21600

# --- APIs externas (Fase 3) ---------------------------------------------------
# Todas opcionales: si falta una clave, ese check se marca "no disponible"
# en lugar de romper el informe.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
# Censys como alternativa a Shodan
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- Google AdSense (Fase 5) --------------------------------------------------
# Déjalo vacío hasta que Google apruebe la cuenta manualmente.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false
